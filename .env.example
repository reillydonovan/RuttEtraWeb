# -----------------------------------------------------------------------
# Sample video source
# -----------------------------------------------------------------------
# URL shown as "Load Sample" in Source → Video File.
# Defaults to /samples/sample.mp4 (relative to the page origin), which
# maps to public/samples/sample.mp4 in your deployment.
#
# Override if your video lives on a CDN or a different host:
#   VITE_SAMPLE_VIDEO_URL=https://cdn.example.com/samples/demo.mp4
#
# Leave unset to use the default relative path.
# The button is hidden automatically if no file exists at the URL.
# VITE_SAMPLE_VIDEO_URL=

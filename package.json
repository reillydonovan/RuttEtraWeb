{
  "name": "rutt-etra-web",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Web-based Rutt/Etra video synthesizer with full native controls, free-flight 3D camera, recording, and WebRTC peer-to-peer share links",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.169.0",
    "jsdom": "^29.1.1",
    "marked": "^14.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "workbox-window": "^7.4.1"
  }
}
